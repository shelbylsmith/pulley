# ── GitHub App ──────────────────────────────────────
# Note: inline comments after values are not stripped by dotenv/docker parsers —
# keep every comment on its own line.
GITHUB_APP_ID=
# PEM contents, or leave empty and point GITHUB_APP_PRIVATE_KEY_PATH at the file
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── Slack App ──────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Fallback only; per-org bot tokens are stored in the database
SLACK_BOT_TOKEN=

# ── Database ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pulley:pulley@localhost:5432/pulley

# ── App ────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Comma-separated `owner/repo` allow/deny lists. Empty allowlist = every installed repo.
GITHUB_ALLOWED_REPOS=
GITHUB_EXCLUDED_REPOS=

# ── Scheduling ─────────────────────────────────────
# Two ways to fire the daily recap and stale-PR reminders — pick one:
#   1. Always-on single instance: set SCHEDULER_ENABLED=true. The in-app
#      scheduler evaluates each org's cron every minute.
#   2. Serverless / multi-instance: leave SCHEDULER_ENABLED=false, set
#      INTERNAL_API_TOKEN, and have an external cron POST to /internal/recap and
#      /internal/stale-reminders with `Authorization: Bearer <token>`.
# Setting neither means recap/reminders never fire.
# Cron expressions are standard 5-field, evaluated in UTC.
SCHEDULER_ENABLED=false
# Fallback when an org's recap_cron is unset
RECAP_CRON=0 9 * * 1-5
STALE_REMINDER_CRON=0 14 * * 1-5
# When empty, /internal/* returns 404
INTERNAL_API_TOKEN=
